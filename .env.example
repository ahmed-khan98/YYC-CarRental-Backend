MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/yyc-car-rental?appName=Cluster0
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
PORT=5000

# Local/VPS file storage (Cloudinary is not used)
# Default folder is public/uploads. On the VPS you can set an absolute path:
# UPLOAD_DIR=/var/www/yyc-car-rental/public/uploads
# Public origin for stored file URLs. Leave empty for /uploads/... relative URLs.
# If the API is on a different host than the website, set the public API origin:
# PUBLIC_BASE_URL=https://api.yyccarrental.com

SMTP_HOST=mail.yyccarrental.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=booking@yyccarrental.com
SMTP_PASS=your_email_password
SMTP_FROM=booking@yyccarrental.com
CONTACT_TO=booking@yyccarrental.com
# Optional extra copy (useful if cPanel files self-mail into Sent):
# CONTACT_BCC=info@yyccarrental.com
# If AUTH 535 persists after setting the real mailbox password, try:
# SMTP_PORT=587
# SMTP_SECURE=false
# After a successful send, check Inbox, Sent, and Junk — From and To are
# the same booking@ mailbox, so some cPanel hosts skip Inbox.
